const BinarySort = (A, N) => {
  let i = 0;
  let j = 0;
  while (i < N) {
    if (A[i] == 0) {
      [A[i], A[j]] = [A[j], A[i]];
      i++;
      j++;
    } else {
      i++;
    }
  }
  return A;
};

