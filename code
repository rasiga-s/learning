const findElement = (arr, start, end, key) => {
  let mid = end + start / 2;

  if (arr[mid] === key) {
    return mid;
  } else if (arr[mid] > key) {
    return findElement(arr, start, mid - 1, key);
  } else if (arr[mid] < key) {
    return findElement(arr, mid + 1, end, key);
  }
};
const value = findElement(arr, start, end, key);
