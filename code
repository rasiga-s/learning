const reverseInegers = (num) => {
  let rev = '';
  let val = num < 0 ? 1 : 0;
  for (let i = val; i < num.length; i++) {
    rev = num[i] + rev;
  }
  return num < 0 ? '-' + rev : rev;
};
console.log(reverseInegers('-123'));

const removeDublicateWitoutNewArray = (arr) => {
  for (let i = 0; i < arr.length; i++) {
    if (arr.indexOf(arr[i]) !== arr.lastIndexOf(arr[i])) {
      arr.splice(i, 1);
    }
  }
  return arr;
};

