Array.prototype.createFilter = function (callback) {
  let result = [];
  for (let i = 0; i < this.length; i++) {
    if (callback(this[i])) {
      result.push(this[i]);
    }
  }
  return result;
};

console.log([2, 3, 4].createFilter((ele) => ele > 3));

Array.prototype.createSort = function (callback) {
  const newArray = [...this];

  for (let i = 0; i < newArray.length; i++) {
    for (let j = 0; j < newArray.length - 1; j++) {
      if (callback(newArray[j], newArray[j + 1]) > 0) {
        const temp = newArray[j + 1];
        newArray[j + 1] = newArray[j];
        newArray[j] = temp;
      }
    }
  }
  return newArray;
};

console.log([4, 5, 8, 3, 2, 6].createSort((a, b) => a - b));

Array.prototype.createReduce = function (callback, acc) {
  for (let i = 0; i < this.length; i++) {
    acc = callback(this[i], acc);
  }
  return acc;
};

