const unCommonChar = (a, b) => {
  let resultA = a
    .split('')
    .filter((elem) => b.indexOf(elem) == -1)
    .join('');
  let resultB = b
    .split('')
    .filter((elem) => a.indexOf(elem) == -1)
    .join('');
  let merge = resultA.concat(resultB);
  if (merge == '') {
    return -1;
  }
  let array = merge.split('');
  let ele = [];
  for (let i = 0; i < array.length; i++) {
    if (!ele.includes(array[i])) {
      ele.push(array[i]);
    }
  }
  let ele1 = ele.sort();
  return ele1.join('');
};

function unCommonChar1(str1, str2) {
  let set1 = new Set(str1);
  let set2 = new Set(str2);
  let result = [];

  for (let char of set1) {
    if (!set2.has(char)) {
      result.push(char);
    }
  }

  for (let char of set2) {
    if (!set1.has(char)) {
      result.push(char);
    }
  }

  return result.join('');
}

