function PromisePloyFill(excutor) {
  let OnResolve, OnReject;

  function resolve(value) {
    OnResolve(value);
  }
  function reject(value) {
    OnReject(value);
  }
  this.then = function (callback) {
    OnResolve = callback;
    return this;
  };
  this.catch = function (callback) {
    OnReject = callback;
    return this;
  };
  excutor(resolve, reject);
}

