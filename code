Array.prototype.createEvery = function (callback) {
  for (let i = 0; i < this.length; i++) {
    if (!callback(this[i])) {
      return false;
    }
  }
  return true;
};

console.log([6, 4, 5].createEvery((element) => element > 3));

let arr = [3, 4, 5, 6, 7, 9];
let start = 0;
let end = arr.length - 1;
let key = 4;

const findElement = (arr, start, end, key) => {
  let mid = end + start / 2;

  if (arr[mid] === key) {
    return mid;
  } else if (arr[mid] > key) {
    return findElement(arr, start, mid - 1, key);
  } else if (arr[mid] < key) {
    return findElement(arr, mid + 1, end, key);
  }
};
const value = findElement(arr, start, end, key);
console.log('find Element', value);

Array.prototype.createMap = function (callback) {
  let result = [];
  for (let i = 0; i < this.length; i++) {
    result.push(callback(this[i], i));
  }
  return result;
};

console.log([2, 3, 4].createMap((ele) => ele + 2));

Array.prototype.createFilter = function (callback) {
  let result = [];
  for (let i = 0; i < this.length; i++) {
    if (callback(this[i])) {
      result.push(this[i]);
    }
  }
  return result;
};

console.log([2, 3, 4].createFilter((ele) => ele > 3));

Array.prototype.createSort = function (callback) {
  const newArray = [...this];

  for (let i = 0; i < newArray.length; i++) {
    for (let j = 0; j < newArray.length - 1; j++) {
      if (callback(newArray[j], newArray[j + 1]) > 0) {
        const temp = newArray[j + 1];
        newArray[j + 1] = newArray[j];
        newArray[j] = temp;
      }
    }
  }
  return newArray;
};

console.log([4, 5, 8, 3, 2, 6].createSort((a, b) => a - b));

Array.prototype.createReduce = function (callback, acc) {
  for (let i = 0; i < this.length; i++) {
    acc = callback(this[i], acc);
  }
  return acc;
};

console.log([2, 3, 4].createReduce((acc, ele) => acc + ele, 0));

