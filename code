  let i = 0;
  let j = Math.floor(arr.length / 2);
  let res = [];
  while (i < j && j < n) {
    if (i < j) {
      res.push(arr[i]);
    }
    if (j < arr.length) {
      res.push(arr[j]);
    }
    i++;
    j++;
  }
  for (let i = 0; i < arr.length; i++) {
    arr[i] = res[i];
  }
  return arr;
};

