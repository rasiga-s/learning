var findGCD = function (nums) {
  nums.sort((a, b) => a - b);
  while (nums[0] != nums[nums.length - 1]) {
    if (nums[0] > nums[nums.length - 1]) {
      nums[0] -= nums[nums.length - 1];
    } else {
      nums[nums.length - 1] -= nums[0];
    }
  }
  return nums[0];
};
