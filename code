const OddandEvenSort = (arr) => {
  let odds = [];
  arr.sort((a, b) => a - b);
  for (let i = 0; i < arr.length; i++) {
    if (arr[i] % 2 !== 0) {
      odds.push(arr[i]);
      arr.splice(i, 1);
      i--;
    }
  }
  odds.sort((a, b) => a - b);
  let res = odds.concat(arr);
  for (let i = 0; i < res.length; i++) {
    arr[i] = res[i];
  }
  return res;
};

