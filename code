const findIndexOccuerance = (arr, n, x) => {
  let [start, end] = [0, n - 1];
  while (start <= end) {
    if (arr[start] == x && arr[end] == x) {
      return [start, end];
    }
    if (x > arr[start]) {
      start++;
    }
    if (x < arr[end]) {
      end--;
    }
  }
  return [-1, -1];
};

