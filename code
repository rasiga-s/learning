const reverseOnlyChar = (S) => {
  let l = 0;
  let r = S.length - 1;
  let arr = S.split('');

  while (l < r) {
    if (!isAlpha(arr[l])) {
      l++;
    }
    if (!isAlpha(arr[r])) {
      r--;
    }
    if (isAlpha(arr[l]) && isAlpha(arr[r])) {
      [arr[l], arr[r]] = [arr[r], arr[l]];
      l++;
      r--;
    }
  }
  return arr.join('');
};
