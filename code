const deepCopy = (obj) => {
  let tempObj = {};
  for (let key in obj) {
    if (typeof obj[key] == 'object') {
      tempObj[key] = deepCopy(obj[key]);
    } else {
      tempObj[key] = obj[key];
    }
  }
  return tempObj;
};

