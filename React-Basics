10.useActionState(new hook)
useActionState manages the result and pending state of an Action, making it useful for form submissions and other action-based UI updates

import { useActionState } from "react";
async function submitForm(previousState, formData) {
  const name = formData.get("name");
  if (!name) {
    return {
      error: "Name is required"
    };
  }
  return {
    success: true
  };
}

function Form() {
  const [state, formAction, isPending] = useActionState(
    submitForm,
    {}
  );
  return (
    <form action={formAction}>
      <input name="name" />

      <button disabled={isPending}>
        {isPending ? "Saving..." : "Save"}
      </button>

      {state.error && <p>{state.error}</p>}
      {state.success && <p>Saved!</p>}
    </form>
  );
}

11.useOptimistic
This is used when you want the UI to immediately show the expected result before the server confirms it.
Example: Like button.

Without optimistic UI:

Click Like
   ↓
API request
   ↓
Server response
   ↓
Update UI

User may experience delay.

With optimistic UI:

Click Like
   ↓
Immediately show ❤️
   ↓
API request
   ↓
Server confirms

import { useOptimistic } from "react";

function LikeButton({ likes, updateLike }) {
  const [optimisticLikes, addOptimisticLike] =
    useOptimistic(
      likes,
      (currentLikes, amount) => currentLikes + amount
    );

  async function handleLike() {
    addOptimisticLike(1);

    await updateLike();
  }

  return (
    <button onClick={handleLike}>
      ❤️ {optimisticLikes}
    </button>
  );
}

